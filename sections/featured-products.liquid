{% comment %}
  Featured Products Section
  Showcase featured/bestselling products
{% endcomment %}

{{ 'halo-custom.css' | asset_url | stylesheet_tag }}

<section class="featured-products">
  <div class="featured-products__container">
    {% if section.settings.heading != blank %}
      <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="featured-products__grid">
      {% comment %} Loop through selected products {% endcomment %}
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign product = all_products[block.settings.product] %}
          {% if product != blank %}
            {% render 'product-card-custom', product: product %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% comment %} Placeholder if no products selected {% endcomment %}
        <div class="product-card">
          <div class="product-card__image product-card__image--placeholder">
            <svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
              <rect width="300" height="200" fill="#F8F9FA"/>
              <text x="50%" y="50%" text-anchor="middle" dy=".3em" fill="#666" font-size="14">Sample Product</text>
            </svg>
          </div>
          <h3 class="product-card__title">Sample Compound Name</h3>
          <div class="product-card__price">$99.99</div>
          <a href="#" class="halo-btn product-card__button">View Product</a>
        </div>
        
        <div class="product-card">
          <div class="product-card__image product-card__image--placeholder">
            <svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
              <rect width="300" height="200" fill="#F8F9FA"/>
              <text x="50%" y="50%" text-anchor="middle" dy=".3em" fill="#666" font-size="14">Sample Product</text>
            </svg>
          </div>
          <h3 class="product-card__title">Sample Compound Name</h3>
          <div class="product-card__price">$149.99</div>
          <a href="#" class="halo-btn product-card__button">View Product</a>
        </div>
        
        <div class="product-card">
          <div class="product-card__image product-card__image--placeholder">
            <svg width="300" height="200" xmlns="http://www.w3.org/2000/svg">
              <rect width="300" height="200" fill="#F8F9FA"/>
              <text x="50%" y="50%" text-anchor="middle" dy=".3em" fill="#666" font-size="14">Sample Product</text>
            </svg>
          </div>
          <h3 class="product-card__title">Sample Compound Name</h3>
          <div class="product-card__price">$79.99</div>
          <a href="#" class="halo-btn product-card__button">View Product</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Compounds"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ],
  "max_blocks": 12
}
{% endschema %}
