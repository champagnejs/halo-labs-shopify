{% comment %}
  Trust Badges Section
  Horizontal row of trust indicators
{% endcomment %}

{{ 'halo-custom.css' | asset_url | stylesheet_tag }}

<section class="trust-badges">
  <div class="trust-badges__container">
    <div class="trust-badges__grid">
      {% comment %} Badge 1: Lab Tested {% endcomment %}
      {% if section.settings.badge_1_text != blank %}
        <div class="trust-badges__item">
          <span class="trust-badges__icon" aria-hidden="true">{{ section.settings.badge_1_icon }}</span>
          <span>{{ section.settings.badge_1_text }}</span>
        </div>
      {% endif %}
      
      {% comment %} Badge 2: COA Available {% endcomment %}
      {% if section.settings.badge_2_text != blank %}
        <div class="trust-badges__item">
          <span class="trust-badges__icon" aria-hidden="true">{{ section.settings.badge_2_icon }}</span>
          <span>{{ section.settings.badge_2_text }}</span>
        </div>
      {% endif %}
      
      {% comment %} Badge 3: Research Only {% endcomment %}
      {% if section.settings.badge_3_text != blank %}
        <div class="trust-badges__item">
          <span class="trust-badges__icon" aria-hidden="true">{{ section.settings.badge_3_icon }}</span>
          <span>{{ section.settings.badge_3_text }}</span>
        </div>
      {% endif %}
      
      {% comment %} Badge 4: Secure Checkout {% endcomment %}
      {% if section.settings.badge_4_text != blank %}
        <div class="trust-badges__item">
          <span class="trust-badges__icon" aria-hidden="true">{{ section.settings.badge_4_icon }}</span>
          <span>{{ section.settings.badge_4_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "text",
      "id": "badge_1_icon",
      "label": "Badge 1 Icon (Emoji or Unicode)",
      "default": "✓"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 Text",
      "default": "Third-Party Lab Tested"
    },
    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "text",
      "id": "badge_2_icon",
      "label": "Badge 2 Icon (Emoji or Unicode)",
      "default": "📄"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 Text",
      "default": "Certificate of Analysis Available"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "text",
      "id": "badge_3_icon",
      "label": "Badge 3 Icon (Emoji or Unicode)",
      "default": "🔬"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 Text",
      "default": "Research Purposes Only"
    },
    {
      "type": "header",
      "content": "Badge 4"
    },
    {
      "type": "text",
      "id": "badge_4_icon",
      "label": "Badge 4 Icon (Emoji or Unicode)",
      "default": "🔒"
    },
    {
      "type": "text",
      "id": "badge_4_text",
      "label": "Badge 4 Text",
      "default": "Secure Checkout"
    }
  ],
  "presets": [
    {
      "name": "Trust Badges"
    }
  ]
}
{% endschema %}
