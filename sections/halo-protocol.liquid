{% comment %}
  The Halo Protocol Section
  Educational/trust-building content area with 3 columns
{% endcomment %}

{{ 'halo-custom.css' | asset_url | stylesheet_tag }}

<section class="halo-protocol">
  <div class="halo-protocol__container">
    {% if section.settings.heading != blank %}
      <h2 class="halo-protocol__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    <div class="halo-protocol__grid">
      {% comment %} Column 1: Lab Tested {% endcomment %}
      <div class="halo-protocol__item">
        <span class="halo-protocol__icon" aria-hidden="true">{{ section.settings.icon_1 }}</span>
        <h3 class="halo-protocol__title">{{ section.settings.title_1 }}</h3>
        <p class="halo-protocol__text">{{ section.settings.text_1 }}</p>
      </div>
      
      {% comment %} Column 2: Research Grade {% endcomment %}
      <div class="halo-protocol__item">
        <span class="halo-protocol__icon" aria-hidden="true">{{ section.settings.icon_2 }}</span>
        <h3 class="halo-protocol__title">{{ section.settings.title_2 }}</h3>
        <p class="halo-protocol__text">{{ section.settings.text_2 }}</p>
      </div>
      
      {% comment %} Column 3: Research Purposes {% endcomment %}
      <div class="halo-protocol__item">
        <span class="halo-protocol__icon" aria-hidden="true">{{ section.settings.icon_3 }}</span>
        <h3 class="halo-protocol__title">{{ section.settings.title_3 }}</h3>
        <p class="halo-protocol__text">{{ section.settings.text_3 }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Halo Protocol",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "The Halo Protocol"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "icon_1",
      "label": "Icon 1 (Emoji or Unicode)",
      "default": "🔬"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title 1",
      "default": "Lab Tested & Verified"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Text 1",
      "default": "Every batch undergoes rigorous third-party laboratory testing to ensure purity and quality standards."
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "icon_2",
      "label": "Icon 2 (Emoji or Unicode)",
      "default": "⚗️"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title 2",
      "default": "Research Grade Purity"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Text 2",
      "default": "Pharmaceutical-grade compounds manufactured to the highest industry standards for research applications."
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "text",
      "id": "icon_3",
      "label": "Icon 3 (Emoji or Unicode)",
      "default": "📋"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Title 3",
      "default": "For Research Purposes Only"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Text 3",
      "default": "All products are intended for laboratory research and scientific study. Not for human consumption."
    }
  ],
  "presets": [
    {
      "name": "Halo Protocol"
    }
  ]
}
{% endschema %}
